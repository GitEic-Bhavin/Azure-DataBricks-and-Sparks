{
  "name": "@storage-explorer/managed-disks-extension",
  "version": "1.7.16",
  "description": "",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --no-core-http --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "node --test dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "appConfigurations": [
      {
        "id": "managedDisksExtension.managedDisksExplorer.columnData",
        "type": "string",
        "defaultValue": "{ \"columns\": [] }"
      }
    ],
    "jobHandlers": [
      {
        "queueName": "managed-disks-copy-disk",
        "jobHandlerClass": "./dist/src/JobHandlers/CopyDiskJobHandler.js",
        "resourceType": "large"
      }
    ],
    "dialogs": {
      "ManagedDisks.Dialog.CreateSnapshot": {
        "dimensions": {
          "height": 375,
          "width": 510
        },
        "view": "./dist/src/Dialogs/index.html#createSnapshot"
      },
      "ManagedDisks.Dialog.CreateDisk": {
        "dimensions": {
          "height": 695,
          "width": 635
        },
        "view": "./dist/src/Dialogs/index.html#createDisk"
      },
      "ManagedDisks.Dialog.PasteDisk": {
        "dimensions": {
          "height": 475,
          "width": 510
        },
        "view": "./dist/src/Dialogs/index.html#pasteDisk"
      }
    },
    "functions": [
      "StorageExplorer.ManagedDisks.produceTypeNodes",
      "StorageExplorer.ManagedDisks.produceResourceGroupsNodes",
      "StorageExplorer.ManagedDisks.produceResourceGroupsNode",
      "StorageExplorer.ManagedDisks.openManagedDisksExplorer",
      "StorageExplorer.ManagedDisks.openResourceInPortal",
      "StorageExplorer.ManagedDisks.uploadDisk",
      "StorageExplorer.ManagedDisks.downloadDisk",
      "StorageExplorer.ManagedDisks.pasteDisk",
      "StorageExplorer.ManagedDisks.createSnapshot",
      "StorageExplorer.ManagedDisks.deleteDisk",
      "StorageExplorer.ManagedDisks.listDisksByResourceGroup",
      "StorageExplorer.ManagedDisks.onPanelClone",
      "StorageExplorer.ManagedDisks.cancel",
      "StorageExplorer.ManagedDisks.addCancelAction"
    ],
    "panels": {
      "managedDisksEditor": {
        "view": "./dist/src/Editors/ManagedDisksExplorerReact/index.html",
        "cloneCallback": "StorageExplorer.ManagedDisks.onPanelClone"
      }
    },
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Azure.StorageExplorerSubscriptionWithResourceTypes"
        ],
        "nodeType": "StorageExplorer.ManagedDisks.ManagedDisksResourceType",
        "function": "StorageExplorer.ManagedDisks.produceTypeNodes",
        "args": [
          "subscription"
        ]
      },
      {
        "parentNodeTypes": [
          "StorageExplorer.ManagedDisks.ManagedDisksResourceType"
        ],
        "nodeType": "Microsoft.Resources/resourceGroups",
        "search": {
          "searchType": "Microsoft.Resources/resourceGroupsSearchType",
          "searchLabel": "DiskNodeProducer.ResourceGroupNodeSearchLabel",
          "enableConfigId": "services.disks.enable"
        },
        "function": "StorageExplorer.ManagedDisks.produceResourceGroupsNodes",
        "args": [
          "subscription"
        ]
      }
    ],
    "resources": [
      {
        "namespace": "DiskNodeProducer",
        "module": "./resources/DiskNodeProducer"
      },
      {
        "namespace": "AzureLocations",
        "module": "./resources/AzureLocations"
      },
      {
        "namespace": "ManagedDisks",
        "module": "./resources/ManagedDisks"
      },
      {
        "namespace": "ManagedDisksExplorer",
        "module": "./resources/ManagedDisksExplorer"
      },
      {
        "namespace": "DiskCopy",
        "module": "./resources/DiskCopy"
      },
      {
        "namespace": "DiskDelete",
        "module": "./resources/DiskDelete"
      },
      {
        "namespace": "CreateDiskDialog",
        "module": "./resources/CreateDiskDialog"
      },
      {
        "namespace": "PasteDiskDialog",
        "module": "./resources/PasteDiskDialog"
      },
      {
        "namespace": "CreateSnapshotDialog",
        "module": "./resources/CreateSnapshotDialog"
      },
      {
        "namespace": "SnapshotDisk",
        "module": "./resources/SnapshotDisk"
      }
    ]
  },
  "extensionDependencies": [],
  "devDependencies": {
    "@azure/identity": "^4.5.0",
    "@storage-explorer/build-common": "^1.4.1",
    "@storage-explorer/testing": "^4.0.0",
    "@types/jquery": "^3.3.31",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/sprintf-js": "^1.1.2",
    "@types/underscore": "1.7.33",
    "storage-explorer": "^1.41.0-beta.3",
    "typescript": "^5.0.0",
    "@azure-tools/azcopy-node": "3.4.13-rc.1",
    "@azure/arm-compute": "^20.0.0",
    "@azure/arm-resources": "^5.2.0",
    "@azure/arm-resources-subscriptions": "^2.0.1",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/job-queue": "^1.0.0",
    "@storage-explorer/ui-components": "^5.0.15",
    "@storage-explorer/ui-components-panel": "npm:@storage-explorer/ui-components@^4.1.20",
    "jquery": "^3.4.1",
    "knockout": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}