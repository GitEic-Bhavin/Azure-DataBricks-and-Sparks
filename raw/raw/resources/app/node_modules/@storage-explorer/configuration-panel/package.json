{
  "name": "@storage-explorer/configuration-panel",
  "version": "1.2.2",
  "description": "A Storage Explorer extension that defines the settings panel UI elements",
  "main": "./dist/main/index.js",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd .",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "echo \"No tests to run.\" && exit 0"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "resources": [
      {
        "namespace": "SettingsPanel",
        "module": "resources/SettingsPanel"
      }
    ],
    "verticalToolbarButtons": {
      "SettingsPanel": {
        "type": "function",
        "functionName": "ConfigurationEditor.open",
        "icon": "Settings",
        "displayName": "Shell.MenuSettings"
      }
    },
    "functions": [
      "ConfigurationEditor.open",
      "ConfigurationEditor.onPanelClone"
    ],
    "panels": {
      "configurationEditor": {
        "view": "./dist/SettingsPanel/index.html",
        "cloneCallback": "ConfigurationEditor.onPanelClone"
      }
    }
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.4.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "storage-explorer": "^1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@storage-explorer/ui-components": "^4.1.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sprintf-js": "^1.1.3"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  }
}