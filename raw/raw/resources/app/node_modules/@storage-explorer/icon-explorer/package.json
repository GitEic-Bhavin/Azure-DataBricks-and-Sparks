      },
      "iconExplorer": {
        "view": "./dist/src/Panels/IconExplorer/index.html"
      }
    }
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.1.6",
