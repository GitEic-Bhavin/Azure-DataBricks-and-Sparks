{
  "name": "@storage-explorer/explorer-panel",
  "version": "1.3.16",
  "description": "",
  "main": "dist/src/main/index.js",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "mocha dist/test/**/*.js"
  },
  "storageExplorer": {
    "displayName": "Explorer Panel",
    "functions": [],
    "resources": [
      {
        "namespace": "ExplorerPanel",
        "module": "./resources/ExplorerPanel"
      }
    ],
    "panels": {
      "ExplorerPanel.explorerPanel": {
        "view": "./dist/src/panels/ExplorerPanel/index.html"
      }
    },
    "verticalToolbarButtons": {
      "ExplorerPanel.openExplorerPanel": {
        "type": "panel",
        "panelId": "ExplorerPanel.explorerPanel",
        "icon": "BulletedTree",
        "displayName": "ExplorerPanel.PanelTitle"
      }
    },
    "configurations": [
      {
        "id": "tree.search.checkedTypes",
        "type": "stringArray"
      }
    ]
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.2.4",
    "@storage-explorer/testing": "^3.1.0",
    "@types/chai": "^4.1.7",
    "@types/mocha": "^5.2.6",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "storage-explorer": "^1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@storage-explorer/ui-components": "^4.1.6",
    "knockout": "^3.5.1",
    "se-exception-serializer": "^0.1.6",
    "se-resizable-layout": "^0.1.7",
    "sprintf-js": "^1.1.2"
  },
  "author": "",
  "license": "ISC",
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}