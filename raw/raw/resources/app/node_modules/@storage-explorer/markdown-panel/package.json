{
  "name": "@storage-explorer/markdown-panel",
  "version": "1.1.2-rc.2",
  "description": "",
  "main": "dist/main/index.js",
  "typings": "dist/main/index.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --no-core-http",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "echo \"No tests to run.\" && exit 0"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "functions": [
      "MarkdownPanel.openFile",
      "MarkdownPanel.openContent",
      "MarkdownPanel.onPanelClone"
    ],
    "panels": {
      "markdown-panel.markdownPanel": {
        "view": "./dist/MarkdownPanel/index.html",
        "cloneCallback": "MarkdownPanel.onPanelClone"
      }
    }
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.2.4",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^16.0.0",
    "storage-explorer": "^1.33.0-beta.3",
    "typescript": "^5.0.0",
    "knockout": "^3.5.0",
    "markdown-it": "^13.0.0",
    "tslib": "^2.0.0"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  }
}