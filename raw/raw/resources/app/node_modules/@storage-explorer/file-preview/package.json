{
  "name": "@storage-explorer/file-preview",
  "version": "0.7.8",
  "description": "An extension that supports previewing blob data in Storage Explorer",
  "main": "dist/src/index.js",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir --no-core-http --no-core-rest --no-core-auth",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "test": "node --test dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "functions": [
      "FilePreview.fetchTabularData",
      "FilePreview.fetchTextData",
      "FilePreview.previewTabular",
      "FilePreview.previewText",
      "FilePreview.previewImage",
      "FilePreview.previewVideo",
      "FilePreview.previewPdf",
      "FilePreview.previewParquet",
      "FilePreview.previewAudio",
      "FilePreview.previewModel3D"
    ],
    "resources": [
      {
        "namespace": "FilePreview",
        "module": "resources/FilePreview"
      }
    ],
    "configurations": [
      {
        "id": "services.storageAccounts.textFileExtensions",
        "type": "stringArray",
        "title": "FilePreview.TitleTextFileExtensions",
        "description": "FilePreview.DescriptionTextFileExtensions",
        "defaultValue": [
          ".txt",
          ".js",
          ".html",
          ".json"
        ],
        "sortOrder": 2
      }
    ],
    "panels": {
      "model3DPreview": {
        "view": "dist/src/Panels/Model3DPreviewPanel/index.html"
      },
      "textPreview": {
        "view": "dist/src/Panels/TextPreviewPanel/index.html"
      },
      "simplePreview": {
        "view": "dist/src/Panels/SimplePreviewPanel/index.html"
      },
      "tabularPreview": {
        "view": "dist/src/Panels/TabularPreviewPanel/index.html"
      }
    }
  },
  "devDependencies": {
    "@storage-explorer/build-common": "1.4.1",
    "@storage-explorer/testing": "^4.0.0",
    "@types/json-bigint": "^1.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/sprintf-js": "^1.1.2",
    "@types/three": "^0.163.0",
    "typescript": "^5.0.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/ui-components": "^4.1.20",
    "avsc": "^5.7.9",
    "csv-parse": "^5.3.6",
    "json-bigint": "^1.0.0",
    "monaco-editor-core": "^0.52.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "1.1.2",
    "storage-explorer": "^1.39.0-beta.2",
    "three": "^0.162.0"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "peerDependencies": {
    "@dsnp/parquetjs": "^1.8.7"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}