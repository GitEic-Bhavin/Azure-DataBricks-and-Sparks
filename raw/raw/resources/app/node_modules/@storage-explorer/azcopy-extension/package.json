{
  "name": "@storage-explorer/azcopy-extension",
  "version": "1.7.27",
  "description": "",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --no-core-http --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "mocha \"dist/test/**/*.js\""
  },
  "license": "UNLICENSED",
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  },
  "storageExplorer": {
    "functions": [
      "AzCopy.Blob.uploadBlobs",
      "AzCopy.Blob.downloadBlobs",
      "AzCopy.Blob.pasteBlobs",
      "AzCopy.Blob.deleteBlobs",
      "AzCopy.Blob.openBlob",
      "AzCopy.Blob.watchFileCallback",
      "AzCopy.Blob.promoteVersion",
      "AzCopy.Blob.promoteVersionCallback",
      "AzCopy.BlobContainer.copyContainer",
      "AzCopy.AdlsGen2.uploadPaths",
      "AzCopy.AdlsGen2.downloadPaths",
      "AzCopy.AdlsGen2.deletePaths",
      "AzCopy.FileShare.uploadFiles",
      "AzCopy.FileShare.downloadFiles",
      "AzCopy.FileShare.pasteFiles",
      "AzCopy.FileShare.restoreFile",
      "AzCopy.FileShare.restoreFileCallback",
      "AzCopy.FileShare.openFile",
      "AzCopy.FileShare.deleteFiles",
      "AzCopy.FileShare.copyFileShare",
      "AzCopy.FileShare.watchFileCallback",
      "AzCopy.Retry.retryCopy",
      "AzCopy.Retry.retryDelete",
      "AzCopy.Promotion.response",
      "AzCopy.Common.version",
      "AzCopy.Common.cancel",
      "AzCopy.Common.addCancelAction",
      "AzCopy.Common.handleCredentialStoreError",
      "AzCopy.Common.getDirectoryAndBaseNames",
      "AzCopy.Settings.getAll"
    ],
    "dialogs": {
      "AzCopy.Dialog.Retry": {
        "dimensions": {
          "width": 930,
          "height": 600
        },
        "view": "./dist/src/Dialogs/index.html#retry"
      },
      "AzCopy.Dialog.UploadBlobs": {
        "dimensions": {
          "height": 630,
          "width": 520
        },
        "view": "./dist/src/Dialogs/index.html#uploadBlobs"
      }
    },
    "resources": [
      {
        "namespace": "AzCopy",
        "module": "resources/AzCopy"
      },
      {
        "namespace": "AzCopySettings",
        "module": "resources/AzCopySettings"
      },
      {
        "namespace": "RetryTransfersDlg",
        "module": "./resources/RetryTransfersDlg"
      },
      {
        "namespace": "UploadBlobsDlg",
        "module": "./resources/UploadBlobsDlg"
      },
      {
        "namespace": "Copy",
        "module": "./resources/Copy"
      },
      {
        "namespace": "Delete",
        "module": "./resources/Delete"
      }
    ],
    "jobHandlers": [
      {
        "queueName": "azcopy-copy",
        "jobHandlerClass": "dist/src/JobHandlers/AzCopyJobsHandler",
        "resourceType": "azcopy-copy"
      },
      {
        "queueName": "azcopy-delete",
        "jobHandlerClass": "dist/src/JobHandlers/AzCopyJobsHandler",
        "resourceType": "quick"
      }
    ],
    "configurations": [
      {
        "id": "transfers.azCopy.sasDuration",
        "type": "number",
        "title": "AzCopySettings.TitleBlobSasDuration",
        "description": "AzCopySettings.DescriptionBlobSasDuration",
        "defaultValue": 30,
        "sortOrder": 2
      },
      {
        "id": "transfers.azCopy.bandwidthLimit",
        "type": "number",
        "title": "AzCopySettings.TitleBandwidthLimit",
        "description": "AzCopySettings.DescriptionBandwidthLimit",
        "sortOrder": 3
      },
      {
        "id": "transfers.azCopy.concurrencyValue",
        "type": "number",
        "title": "AzCopySettings.TitleConcurrencyValue",
        "description": "AzCopySettings.DescriptionConcurrencyValue",
        "sortOrder": 4
      },
      {
        "id": "transfers.azCopy.concurrencyValue2",
        "type": "string",
        "title": "AzCopySettings.TitleConcurrencyValue",
        "description": "AzCopySettings.DescriptionConcurrencyValue",
        "sortOrder": 4
      },
      {
        "id": "transfers.azCopy.concurrencyValue3",
        "type": "number",
        "title": "AzCopySettings.TitleConcurrencyValue",
        "description": "AzCopySettings.DescriptionConcurrencyValue",
        "sortOrder": 4,
        "options": [
          {
            "type": "value",
            "title": "AzCopySettings.OptionConcurrencyValueMachineSize",
            "value": -1
          },
          {
            "type": "value",
            "title": "AzCopySettings.OptionConcurrencyValueAuto",
            "value": -2
          },
          {
            "type": "input",
            "title": "AzCopySettings.OptionConcurrencyInput"
          }
        ],
        "defaultValue": -2
      },
      {
        "id": "transfers.azCopy.concurrentFiles",
        "type": "number",
        "title": "AzCopySettings.TitleConcurrencyFiles",
        "description": "AzCopySettings.DescriptionConcurrencyFiles",
        "sortOrder": 5
      },
      {
        "id": "transfers.azCopy.bufferSize",
        "type": "number",
        "title": "AzCopySettings.TitleBufferSize",
        "description": "AzCopySettings.DescriptionBufferSize",
        "sortOrder": 6
      },
      {
        "id": "transfers.azCopy.checkMd5",
        "type": "enum",
        "title": "AzCopySettings.TitleCheckMd5",
        "description": "AzCopySettings.DescriptionCheckMd5",
        "defaultValue": "FailIfDifferent",
        "enumValues": {
          "NoCheck": {
            "displayName": "AzCopySettings.EnumNoCheck",
            "sortOrder": 1
          },
          "LogOnly": {
            "displayName": "AzCopySettings.EnumLogOnly",
            "sortOrder": 2
          },
          "FailIfDifferent": {
            "displayName": "AzCopySettings.EnumFailIfDifferent",
            "sortOrder": 3
          },
          "FailIfDifferentOrMissing": {
            "displayName": "AzCopySettings.EnumFailIfDifferentOrMissing",
            "sortOrder": 4
          }
        },
        "sortOrder": 7
      },
      {
        "id": "transfers.azCopy.putMd5",
        "type": "boolean",
        "title": "AzCopySettings.TitlePutMd5",
        "description": "AzCopySettings.DescriptionPutMd5",
        "defaultValue": true,
        "sortOrder": 8
      },
      {
        "id": "transfers.azCopy.decompress",
        "type": "boolean",
        "title": "AzCopySettings.TitleDecompress",
        "description": "AzCopySettings.DescriptionDecompress",
        "defaultValue": false,
        "sortOrder": 9
      },
      {
        "id": "transfers.azCopy.preserveSmbInfo",
        "type": "boolean",
        "title": "AzCopySettings.TitlePreserveInfo",
        "description": "AzCopySettings.DescriptionPreserveInfo",
        "defaultValue": true,
        "sortOrder": 10
      },
      {
        "id": "transfers.azCopy.preservePermissions",
        "type": "boolean",
        "title": "AzCopySettings.TitlePreservePermissions",
        "description": "AzCopySettings.DescriptionPreservePermissions",
        "defaultValue": false,
        "sortOrder": 11
      },
      {
        "id": "transfers.azCopy.preserveSymlinks",
        "type": "boolean",
        "title": "AzCopySettings.TitlePreserveSymlinks",
        "description": "AzCopySettings.DescriptionPreserveSymlinks",
        "defaultValue": false,
        "sortOrder": 12
      },
      {
        "id": "transfers.azCopy.forceIfReadOnly",
        "type": "boolean",
        "title": "AzCopySettings.TitleForceIfReadOnly",
        "description": "AzCopySettings.DescriptionForceIfReadOnly",
        "defaultValue": false,
        "sortOrder": 13
      },
      {
        "id": "transfers.azCopy.preserveAccessTier",
        "type": "boolean",
        "title": "AzCopySettings.TitlePreserveAccessTier",
        "description": "AzCopySettings.DescriptionPreserveAccessTier",
        "defaultValue": false,
        "sortOrder": 14
      },
      {
        "id": "transfers.azCopy.disableAutoDecoding",
        "type": "boolean",
        "title": "AzCopySettings.TitleDisableAutoDecoding",
        "description": "AzCopySettings.DescriptionDisableAutoDecoding",
        "defaultValue": false,
        "sortOrder": 15
      },
      {
        "id": "transfers.azCopy.includeDirectoryStub",
        "type": "boolean",
        "title": "AzCopySettings.TitleIncludeDirectoryStub",
        "description": "AzCopySettings.DescriptionIncludeDirectoryStub",
        "defaultValue": false,
        "sortOrder": 16
      },
      {
        "id": "transfers.azCopy.transferBlockBlobsWithMinimalBlocks",
        "type": "boolean",
        "title": "AzCopySettings.TitleTransferBlockBlobsWithMinimalBlocks",
        "description": "AzCopySettings.DescriptionTransferBlockBlobsWithMinimalBlocks",
        "defaultValue": false,
        "sortOrder": 17
      },
      {
        "id": "transfers.azCopy.logLevel",
        "type": "enum",
        "title": "AzCopySettings.TitleLogLevel",
        "description": "AzCopySettings.DescriptionLogLevel",
        "defaultValue": "INFO",
        "enumValues": {
          "NONE": {
            "displayName": "AzCopySettings.EnumLogLevelNone",
            "sortOrder": 1
          },
          "WARNING": {
            "displayName": "AzCopySettings.EnumLogLevelWarning",
            "sortOrder": 3
          },
          "ERROR": {
            "displayName": "AzCopySettings.EnumLogLevelError",
            "sortOrder": 4
          },
          "INFO": {
            "displayName": "AzCopySettings.EnumLogLevelInfo",
            "sortOrder": 2
          },
          "DEBUG": {
            "displayName": "AzCopySettings.EnumLogLevelDebug",
            "sortOrder": 4
          }
        },
        "sortOrder": 18
      },
      {
        "id": "transfers.azCopy.autoDeleteLogs",
        "type": "boolean",
        "title": "AzCopySettings.TitleAutoDeleteLogs",
        "description": "AzCopySettings.DescriptionAutoDeleteLogs",
        "defaultValue": false,
        "sortOrder": 19
      },
      {
        "id": "transfers.azCopy.preserveBlobTags",
        "type": "enum",
        "title": "AzCopySettings.TitlePreserveBlobTags",
        "description": "AzCopySettings.DescriptionPreserveBlobTags",
        "defaultValue": "Detect",
        "enumValues": {
          "Detect": {
            "displayName": "AzCopySettings.EnumDetect",
            "sortOrder": 1
          },
          "Preserve": {
            "displayName": "AzCopySettings.EnumPreserve",
            "sortOrder": 2
          },
          "NotPreserve": {
            "displayName": "AzCopySettings.EnumNotPreserve",
            "sortOrder": 3
          }
        },
        "sortOrder": 20
      },
      {
        "id": "transfers.azCopy.azCopyCommandShellLanguage",
        "type": "enum",
        "title": "AzCopySettings.TitleAzCopyCommandShellLanguage",
        "description": "AzCopySettings.DescriptionAzCopyCommandShellLanguage",
        "defaultValue": "auto",
        "enumValues": {
          "auto": {
            "displayName": "AzCopySettings.EnumAutoShell",
            "sortOrder": 1
          },
          "pwsh": {
            "displayName": "AzCopySettings.EnumPowershell",
            "sortOrder": 2
          },
          "bash": {
            "displayName": "AzCopySettings.EnumBash",
            "sortOrder": 3
          }
        },
        "sortOrder": 21
      },
      {
        "id": "transfers.azCopy.allowMultiProcess",
        "type": "boolean",
        "title": "AzCopySettings.TitleAllowMultiProcess",
        "description": "AzCopySettings.DescriptionAllowMultiProcess",
        "defaultValue": false,
        "sortOrder": 22
      }
    ],
    "extensionDependencies": [
      "@storage-explorer/blob-extension",
      "@storage-explorer/adls2-extension"
    ]
  },
  "devDependencies": {
    "@azure/identity": "^4.1.0",
    "@azure/storage-file-datalake": "12.23.0",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/build-common": "^1.4.2",
    "@storage-explorer/testing": "^4.0.1",
    "@types/chai": "4.1.7",
    "@types/jquery": "^3.3.9",
    "@types/mocha": "^5.2.6",
    "@types/node": "^22.0.0",
    "@types/sprintf-js": "^1.1.2",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "rimraf": "3.0.2",
    "storage-explorer": "1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@azure-tools/azcopy-node": "3.4.13-rc.1",
    "@azure/storage-blob": "^12.11.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/job-queue": "^1.0.0",
    "@storage-explorer/ui-components": "^5.0.15",
    "knockout": "^3.5.0",
    "se-exception-serializer": "^0.1.4",
    "se-windows-safe-file-name": "^0.1.4",
    "sprintf-js": "^1.1.2"
  },
  "peerDependencies": {
    "@storage-explorer/system-credentials": ">=1.0.0"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  }
}