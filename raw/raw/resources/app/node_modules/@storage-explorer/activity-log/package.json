{
  "name": "@storage-explorer/activity-log",
  "version": "1.1.4",
  "description": "A Storage Explorer extension providing activity log functionality",
  "main": "./dist/src/index.js",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "mocha dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "functions": [
      "ActivityManager.add",
      "ActivityManager.update",
      "ActivityManager.delete",
      "ActivityManager.get",
      "ActivityManager.getChildren",
      "ActivityManager.executeAction"
    ],
    "panels": {
      "activity-log": {
        "view": "./dist/src/Panels/ActivityLogReact/index.html"
      }
    },
    "resources": [
      {
        "namespace": "ActivityLog",
        "module": "resources/ActivityLog"
      }
    ]
  },
  "extensionDependencies": [],
  "devDependencies": {
    "@storage-explorer/build-common": "^1.2.3",
    "@storage-explorer/testing": "^3.1.1",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/sprintf-js": "^1.1.2",
    "chai": "^4.3.6",
    "mocha": "^10.0.0",
    "storage-explorer": "^1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@storage-explorer/simple-db": "^1.0.0",
    "@storage-explorer/ui-components": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sprintf-js": "^1.1.2"
  }
}