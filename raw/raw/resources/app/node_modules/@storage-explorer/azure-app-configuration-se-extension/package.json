{
  "name": "@storage-explorer/azure-app-configuration-se-extension",
  "version": "0.2.4",
  "description": "A Storage Explorer extension that helps managing Azure App Configuration resources.",
  "publisher": "Microsoft",
  "main": "dist/main/index.js",
  "license": "UNLICENSED",
  "engines": {
    "storageExplorer": "^1.33.0"
  },
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.webpack-extension.js --no-core-http --cwd .",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.webpack-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.webpack-extension.js --cwd . start",
    "test": "echo \"No tests to run.\" && exit 0"
  },
  "storageExplorer": {
    "intVersion": 5,
    "displayName": "Azure App Configuration extension for Storage Explorer (preview)",
    "logo": "dist/Images/AppConfig.svg",
    "feedbackUrl": "https://github.com/microsoft/azure-app-configuration-se-extension/issues",
    "functions": [
      "StorageExplorer.AppConfig.Producer.produceAppConfigStoreGroupNode",
      "StorageExplorer.AppConfig.Producer.produceAppConfigStoreNodes",
      "StorageExplorer.AppConfig.Producer.produceAppConfigStoreQuickAccessNode",
      "StorageExplorer.AppConfig.Explorer.openStore",
      "StorageExplorer.AppConfig.Explorer.openStoreInPortal",
      "StorageExplorer.AppConfig.Action.listSettings",
      "StorageExplorer.AppConfig.Action.AddSetting",
      "StorageExplorer.AppConfig.Action.EditSetting",
      "StorageExplorer.AppConfig.Action.DeleteSettings",
      "StorageExplorer.AppConfig.Action.LockSettings",
      "StorageExplorer.AppConfig.Action.UnlockSettings",
      "StorageExplorer.AppConfig.DeepLink.copyDeepLinkToStore",
      "StorageExplorer.AppConfig.DeepLink.handleDeepLink",
      "StorageExplorer.AppConfig.Action.EditTags"
    ],
    "resources": [
      {
        "namespace": "AppConfig",
        "module": "./resources/AppConfig"
      },
      {
        "namespace": "AppConfigPanel",
        "module": "./resources/AppConfigPanel"
      },
      {
        "namespace": "AppConfigAddEditSetting",
        "module": "./resources/AppConfigAddEditSetting"
      }
    ],
    "panels": {
      "AppConfig.StoreExplorer": {
        "view": "dist/panels/StoreExplorer/index.html"
      }
    },
    "dialogs": {
      "AppConfig.EditSetting": {
        "view": "./dist/dialogs/EditSetting/index.html",
        "dimensions": {
          "width": 400,
          "height": 500
        }
      },
      "AppConfig.AddSetting": {
        "view": "./dist/dialogs/AddSetting/index.html",
        "dimensions": {
          "width": 400,
          "height": 500
        }
      }
    },
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Azure.StorageExplorerSubscriptionWithResourceTypes"
        ],
        "nodeType": "Azure.AppConfigGroup",
        "function": "StorageExplorer.AppConfig.Producer.produceAppConfigStoreGroupNode",
        "args": [
          "subscription"
        ]
      },
      {
        "parentNodeTypes": [
          "Azure.AppConfigGroup"
        ],
        "nodeType": "Azure.AppConfig",
        "search": {
          "searchType": "Azure.AppConfigSearchType",
          "searchLabel": "AppConfig.SearchLabelStore"
        },
        "function": "StorageExplorer.AppConfig.Producer.produceAppConfigStoreNodes",
        "args": [
          "connection"
        ]
      }
    ],
    "icons": {
      "AppConfigColor": {
        "path": "./dist/Images/AppConfig.svg",
        "themed": false
      },
      "AppConfigStoreColor": {
        "path": "./dist/Images/AppConfigStore.svg",
        "themed": false
      },
      "FeatureFlagColor": {
        "path": "./dist/Images/FeatureFlag.svg",
        "themed": false
      }
    }
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.1.6",
    "@types/jquery": "^3.5.13",
    "storage-explorer": "^1.39.0-beta.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@azure/app-configuration": "^1.4.1",
    "@azure/arm-appconfiguration": "^4.0.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/ui-components": "^4.1.11",
    "jquery": "^3.6.0",
    "knockout": "^3.5.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  }
}