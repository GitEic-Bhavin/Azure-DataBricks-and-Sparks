{
  "name": "@storage-explorer/queue-extension",
  "version": "1.6.10",
  "description": "",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "mocha dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "appConfigurations": [
      {
        "id": "queueExtension.queueExplorer.columnData",
        "type": "string",
        "defaultValue": "{ \"columns\": [] }"
      }
    ],
    "dialogs": {
      "Queues.Dialog.AddMessage": {
        "dimensions": {
          "height": 650,
          "width": 500
        },
        "view": "./dist/src/Dialogs/index.html#addMessage"
      },
      "Queues.Dialog.ViewMessage": {
        "dimensions": {
          "height": 650,
          "width": 500
        },
        "view": "./dist/src/Dialogs/index.html#viewMessage"
      },
      "Queues.Dialog.ExportMessages": {
        "dimensions": {
          "width": 700,
          "height": 500
        },
        "view": "./dist/src/Dialogs/index.html#exportMessages"
      },
      "Queues.Dialog.ImportMessages": {
        "dimensions": {
          "width": 700,
          "height": 500
        },
        "view": "./dist/src/Dialogs/index.html#importMessages"
      }
    },
    "panels": {
      "queueExplorerReact": {
        "view": "./dist/src/Panels/QueueExplorerReact/index.html",
        "cloneCallback": "StorageExplorer.Queue.Panel.onPanelClone"
      }
    },
    "functions": [
      "Azure.Connect.connectionAdded.queues",
      "Azure.Producers.Storage.GetSASQueues",
      "Azure.Producers.Storage.GetSingleQueueByName",
      "Azure.Storage.Queue.clearMessages",
      "Azure.Storage.Queue.create",
      "Azure.Storage.Queue.delete",
      "Azure.Storage.Queue.dequeueMessage",
      "Azure.Storage.Queue.estimateMessageCount",
      "Azure.Storage.Queue.getAccessPolicies",
      "Azure.Storage.Queue.peekMessages",
      "Azure.Storage.Queue.sendMessage",
      "Azure.Storage.QueueService.isAvailable",
      "Azure.Storage.QueueService.configureCors",
      "Azure.Storage.QueueService.listQueues",
      "Azure.Storage.QueueService.generateSas",
      "Azure.Storage.QueueService.openQueueByName",
      "Azure.Storage.QueueService.searchQueueByPrefix",
      "StorageExplorer.Queue.NodeAction.openExplorer",
      "StorageExplorer.Queue.Panel.onPanelClone",
      "StorageExplorer.Queues.addQueue",
      "StorageExplorer.Queues.copyDirectLinkToClipboard",
      "StorageExplorer.Queues.copyMessageText",
      "StorageExplorer.Queues.deleteMessages",
      "StorageExplorer.Queues.detachAttachedQueueNode",
      "StorageExplorer.Queues.generateSas",
      "StorageExplorer.Queues.exportMessages",
      "StorageExplorer.Queues.importMessages",
      "StorageExplorer.Queues.manageAcl",
      "StorageExplorer.Queues.manageProperties",
      "StorageExplorer.Queues.moveMessages",
      "StorageExplorer.Queues.requeueMessage",
      "StorageExplorer.Queues.produceAttachedQueueNodes",
      "StorageExplorer.Queues.produceAttachedQueueServiceNode",
      "StorageExplorer.Queues.produceQueueServiceNode",
      "StorageExplorer.Queues.produceQueueNodes",
      "StorageExplorer.Queues.produceQuickAccessQueueNode",
      "StorageExplorer.Queues.validateQueueName",
      "StorageExplorer.Queues.NodeAction.renameAttachedQueue",
      "StorageExplorer.Queues.Utilities.getSampleMessages",
      "StorageExplorer.Queues.detachAll"
    ],
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Microsoft.Storage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts/external"
        ],
        "nodeType": "Azure.QueueGroup",
        "function": "StorageExplorer.Queues.produceQueueServiceNode",
        "args": [
          "subscription",
          "accountName",
          "id",
          "primaryKey",
          "accountKeys",
          "queueEndpoint",
          "primaryConnectionString",
          "supportsQueues",
          "allowSharedKeyAccess",
          "servicesAreAvailable"
        ]
      },
      {
        "parentNodeTypes": [
          "Microsoft.ClassicStorage/storageAccounts/sas"
        ],
        "nodeType": "StorageExplorer.Queues.AttachedQueueService",
        "function": "StorageExplorer.Queues.produceAttachedQueueServiceNode",
        "args": []
      },
      {
        "parentNodeTypes": [
          "Azure.QueueGroup"
        ],
        "nodeType": "Azure.Queue",
        "search": {
          "searchType": "Azure.QueueSearchType",
          "searchLabel": "Queues.QueueNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        },
        "function": "StorageExplorer.Queues.produceQueueNodes",
        "args": [
          "subscription",
          "storageAccountId",
          "serviceConnection"
        ]
      },
      {
        "parentNodeTypes": [
          "StorageExplorer.Queues.AttachedQueueService"
        ],
        "nodeType": "Azure.Queue",
        "search": {
          "searchType": "Azure.QueueSearchType",
          "searchLabel": "Queues.QueueNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        },
        "function": "StorageExplorer.Queues.produceAttachedQueueNodes",
        "args": []
      }
    ],
    "resources": [
      {
        "namespace": "MoveMessages",
        "module": "resources/MoveMessages"
      },
      {
        "namespace": "Queues",
        "module": "resources/Queues"
      },
      {
        "namespace": "QueueEditor",
        "module": "resources/QueueEditor"
      },
      {
        "namespace": "AddMessageDialog",
        "module": "resources/AddMessageDialog"
      },
      {
        "namespace": "ImportMessagesDialog",
        "module": "resources/ImportMessagesDialog"
      },
      {
        "namespace": "ViewMessageDialog",
        "module": "resources/ViewMessageDialog"
      }
    ]
  },
  "devDependencies": {
    "@azure/identity": "^4.5.0",
    "@storage-explorer/build-common": "^1.4.2",
    "@storage-explorer/testing": "^3.1.1",
    "@types/chai": "4.1.7",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/sprintf-js": "^1.1.2",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "rimraf": "^3.0.2",
    "storage-explorer": "^1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@azure/core-http": "^3.0.0",
    "@azure/storage-queue": "^12.27.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/ui-components": "^5.0.15",
    "csv-parse": "^5.3.6",
    "csv-stringify": "^6.3.0",
    "knockout": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}