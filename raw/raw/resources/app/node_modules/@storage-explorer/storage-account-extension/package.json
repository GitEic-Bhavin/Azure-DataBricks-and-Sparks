{
  "name": "@storage-explorer/storage-account-extension",
  "version": "3.2.18",
  "description": "",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "mocha \"dist/test/**/*.js\""
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "configurations": [
      {
        "id": "services.storageAccounts.containerSocketPaths",
        "type": "stringArray",
        "title": "StorageAccountActions.TitleContainerSocketPaths",
        "description": "StorageAccountActions.DescriptionContainerSocketPaths"
      }
    ],
    "functions": [
      "StorageExplorer.StorageAccount.NodeAction.copyDirectLink",
      "StorageExplorer.StorageAccount.NodeAction.copyStorageAccountKey",
      "StorageExplorer.StorageAccount.NodeAction.openMonitoringInsights",
      "StorageExplorer.StorageAccount.NodeAction.openInPortal",
      "StorageExplorer.StorageAccount.NodeAction.changeDefaultAccessTier",
      "StorageExplorer.StorageAccount.NodeAction.detachAccount",
      "StorageExplorer.StorageAccount.NodeAction.generateSharedAccessSignature",
      "StorageExplorer.StorageAccount.NodeAction.renameAttachedAccount",
      "StorageExplorer.StorageAccount.AttributeLoader.loadKeysAndKeyDependentAttributes",
      "StorageExplorer.StorageAccount.AttributeLoader.loadAccountAttributes",
      "StorageExplorer.StorageAccount.AttributeLoader.getArmStorageAccountAttributes",
      "StorageExplorer.StorageAccount.AttributeLoader.loadServicesAreAvailable",
      "StorageExplorer.StorageAccount.NodeProducer.produceAttachedStorageAccountTypeNode",
      "StorageExplorer.StorageAccount.NodeProducer.produceAttachedStorageAccountNodes",
      "StorageExplorer.StorageAccount.NodeProducer.produceResourceGroupNodes",
      "StorageExplorer.StorageAccount.NodeProducer.produceResourceGroupQuickAccessNode",
      "StorageExplorer.StorageAccount.NodeProducer.produceStorageAccountNodeFromConnectionId",
      "StorageExplorer.StorageAccount.NodeProducer.produceStorageAccountNodeFromIdAndSubscription",
      "StorageExplorer.StorageAccount.NodeProducer.produceStorageAccountNodes",
      "StorageExplorer.StorageAccount.NodeProducer.produceStorageAccountResourceTypeNode",
      "Azure.Connect.connectionAdded.accounts"
    ],
    "resources": [
      {
        "namespace": "StorageAccountActions",
        "module": "./resources/StorageAccountActions"
      },
      {
        "namespace": "StorageAccountProducer",
        "module": "./resources/StorageAccountProducer"
      }
    ],
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Azure.StorageExplorerSubscriptionWithResourceTypes"
        ],
        "nodeType": "StorageExplorer.StorageAccount.StorageAccountResourceType",
        "function": "StorageExplorer.StorageAccount.NodeProducer.produceStorageAccountResourceTypeNode",
        "args": [
          "subscription"
        ]
      },
      {
        "parentNodeTypes": [
          "StorageExplorer.StorageAccount.StorageAccountResourceType"
        ],
        "nodeType": "Microsoft.Resources/resourceGroups#storageAccounts",
        "function": "StorageExplorer.StorageAccount.NodeProducer.produceResourceGroupNodes",
        "args": [
          "subscription",
          "subscriptionConnection"
        ]
      },
      {
        "parentNodeTypes": [
          "Microsoft.Resources/resourceGroups#storageAccounts",
          "StorageExplorer.StorageAccount.StorageAccountResourceType"
        ],
        "nodeType": "Microsoft.Storage/storageAccounts",
        "function": "StorageExplorer.StorageAccount.NodeProducer.produceStorageAccountNodes",
        "args": [
          "subscription",
          "subscriptionConnection",
          "resourceGroupName"
        ],
        "search": {
          "searchType": "Azure.StorageAccountSearchType",
          "searchLabel": "StorageAccountProducer.StorageAccountNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        }
      },
      {
        "parentNodeTypes": [
          "Azure.ExternalSubscription"
        ],
        "nodeType": "ResourceTypeGroupNode-ResourceType:External/Microsoft.Storage/storageAccounts",
        "function": "StorageExplorer.StorageAccount.NodeProducer.produceAttachedStorageAccountTypeNode",
        "args": []
      },
      {
        "parentNodeTypes": [
          "ResourceTypeGroupNode-ResourceType:External/Microsoft.Storage/storageAccounts"
        ],
        "nodeType": "Microsoft.ClassicStorage/storageAccounts/external",
        "function": "StorageExplorer.StorageAccount.NodeProducer.produceAttachedStorageAccountNodes",
        "args": [],
        "search": {
          "searchType": "Azure.StorageAccountSearchType",
          "searchLabel": "StorageAccountProducer.StorageAccountNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        }
      }
    ]
  },
  "devDependencies": {
    "@azure/identity": "^4.1.0",
    "@storage-explorer/build-common": "^1.3.6",
    "@storage-explorer/testing": "^4.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0",
    "@azure/arm-resources": "^7.0.0",
    "@azure/arm-storage": "^18.6.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2",
    "storage-explorer": "^1.39.0-beta.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  }
}