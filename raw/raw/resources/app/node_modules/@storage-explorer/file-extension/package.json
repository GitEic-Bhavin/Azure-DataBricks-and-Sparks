{
  "name": "@storage-explorer/file-extension",
  "version": "1.9.10",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "mocha dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "appConfigurations": [
      {
        "id": "fileExtension.fileExplorer.columnData",
        "type": "string",
        "defaultValue": "{ \"columns\": [] }"
      }
    ],
    "dialogs": {
      "connectFileShare": {
        "view": "./dist/src/Dialogs/ConnectFileShare/index.html",
        "dimensions": {
          "width": 600,
          "height": 600
        }
      }
    },
    "functions": [
      "StorageExplorer.FileShare.NodeAction.openExplorer",
      "Azure.Connect.connectionAdded.files",
      "Azure.Storage.FileService.generateSas",
      "Azure.Storage.FileService.configureCors",
      "Azure.Storage.FileService.pasteFileShare",
      "Azure.Storage.FileService.createFileShareAddNodeAndOpen",
      "Azure.Storage.FileShare.cloneFileShare",
      "Azure.Storage.FileShareCopy.copyFileShareRetry",
      "Azure.Storage.FileShareCopy.copyFileShareCallback",
      "Azure.Storage.FileService.listShareSnapshots",
      "Azure.Storage.FileShare.copyFileShare",
      "Azure.Storage.FileShare.copyFileShareCallback",
      "Azure.Storage.FileShare.generateSas",
      "Azure.Storage.File.manageProperties",
      "StorageExplorer.FileShareActions.createNewDirectory",
      "Azure.Storage.FileShare.manageStoredAccessPolicies",
      "Azure.Storage.FileShare.createShareSnapshot",
      "Azure.Storage.FileShare.deleteShareSnapshots",
      "Azure.Storage.FileShare.copyFileShareToClipboard",
      "Azure.Storage.FileShare.showConnectFileShareToVmCommand",
      "Azure.Storage.FileShareProducer.produceFileShareServiceNode",
      "Azure.Storage.FileShareProducer.produceFileShareNodes",
      "Azure.Storage.FileShareProducer.produceAttachedFileShareServiceNode",
      "Azure.Storage.FileShareProducer.produceAttachedFileShareNodes",
      "StorageExplorer.FileShareProducer.detachAttachedContainerNode",
      "Azure.Storage.FileShare.getFileShareAttributes",
      "StorageExplorer.FileShare.listFilesAndDirectories",
      "Azure.Storage.FileShare.deleteShareRemoveNodeAndClose",
      "Azure.Storage.File.selectionStatistics",
      "Azure.Producers.Storage.CreateFileShareFromConnection",
      "Azure.Producers.Storage.GetAllFileShares",
      "Azure.Producers.Storage.GetSingleFileShareByName",
      "Azure.Producers.Storage.GetSASFileShares",
      "StorageExplorer.File.ExplorerCommand.clone",
      "StorageExplorer.File.NodeAction.openShareByName",
      "Azure.Storage.FileService.searchShareByPrefix",
      "StorageExplorer.File.GetAccessPolicies",
      "StorageExplorer.FileShare.onPanelClone",
      "StorageExplorer.FileService.validateFileShareName",
      "StorageExplorer.FileShare.NodeAction.copyDeepLinkV1",
      "StorageExplorer.File.NodeAttribute.getCanPasteFileShareAttribute",
      "StorageExplorer.File.getProperties",
      "StorageExplorer.File.downloadToBuffer",
      "StorageExplorer.File.downloadToBase64",
      "StorageExplorer.FileShare.NodeAction.renameAttachedFileShare",
      "StorageExplorer.File.ExplorerCommand.rename",
      "StorageExplorer.File.ExplorerCommand.move",
      "Azure.Storage.FileService.detachAll"
    ],
    "resources": [
      {
        "namespace": "ConnectFileShareDialog",
        "module": "resources/ConnectFileShareDialog"
      },
      {
        "namespace": "FileServiceActions",
        "module": "resources/FileServiceActions"
      },
      {
        "namespace": "FileEditor",
        "module": "resources/FileEditor"
      },
      {
        "namespace": "FileActions",
        "module": "resources/FileActions"
      },
      {
        "namespace": "FileShareActions",
        "module": "resources/FileShareActions"
      },
      {
        "namespace": "FileShareProducers",
        "module": "resources/FileShareProducers"
      }
    ],
    "panels": {
      "fileExplorer": {
        "view": "dist/src/Panels/FileExplorerReact/index.html",
        "cloneCallback": "StorageExplorer.FileShare.onPanelClone"
      }
    },
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Microsoft.Storage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts/external"
        ],
        "nodeType": "Azure.FileShareGroup",
        "function": "Azure.Storage.FileShareProducer.produceFileShareServiceNode",
        "args": [
          "fileEndpoint",
          "supportsFiles",
          "primaryConnectionString",
          "primaryKey",
          "accountKeys",
          "allowSharedKeyAccess",
          "id",
          "accountKind",
          "skuTier",
          "subscription",
          "resourceGroup",
          "connection"
        ]
      },
      {
        "parentNodeTypes": [
          "Azure.FileShareGroup"
        ],
        "nodeType": "Azure.FileShare",
        "search": {
          "searchType": "Azure.FileShareSearchType",
          "searchLabel": "FileShareProducers.FileShareNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        },
        "function": "Azure.Storage.FileShareProducer.produceFileShareNodes",
        "args": [
          "connectionString",
          "connection",
          "id",
          "subscription",
          "accountKind",
          "skuTier",
          "accountName",
          "resourceGroup",
          "storageAccountConnection"
        ]
      },
      {
        "parentNodeTypes": [
          "Microsoft.ClassicStorage/storageAccounts/sas"
        ],
        "nodeType": "StorageExplorer.AttachedFileShareService",
        "function": "Azure.Storage.FileShareProducer.produceAttachedFileShareServiceNode",
        "args": []
      },
      {
        "parentNodeTypes": [
          "StorageExplorer.AttachedFileService"
        ],
        "nodeType": "Azure.FileShareContainer",
        "search": {
          "searchType": "Azure.FileShareSearchType",
          "searchLabel": "FileShareProducers.FileShareNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        },
        "function": "Azure.Storage.FileShareProducer.produceAttachedFileShareNodes",
        "args": []
      }
    ]
  },
  "devDependencies": {
    "@azure-tools/azcopy-node": "3.4.13-rc.1",
    "@azure/core-http": "^3.0.5",
    "@azure/identity": "^4.1.0",
    "@storage-explorer/build-common": "^1.3.7",
    "@storage-explorer/testing": "^4.0.1",
    "@types/chai": "4.1.7",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/sprintf-js": "^1.1.2",
    "chai": "^4.2.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0",
    "@azure/arm-storage": "^18.1.0",
    "@azure/storage-file-share": "^12.29.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/ui-components": "^5.0.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2",
    "storage-explorer": "^1.39.0-beta.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}