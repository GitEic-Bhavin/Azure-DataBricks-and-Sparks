{
  "name": "@storage-explorer/adls2-extension",
  "version": "1.10.5",
  "description": "A temporary Storage Explorer extension adding support for ADLS Gen 2 resources.",
  "main": "dist/src/index.js",
  "typings": "dist/types.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -ffdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "test": "node --test dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "dialogs": {
      "Azure.Storage.AdlsGen2.managePermissions": {
        "dimensions": {
          "width": 512,
          "height": 650
        },
        "view": "./dist/src/Dialogs/index.html#managePosixAcl"
      },
      "Azure.Storage.AdlsGen2.recursiveAcl": {
        "dimensions": {
          "width": 500,
          "height": 415
        },
        "view": "./dist/src/Dialogs/index.html#recursiveAcl"
      }
    },
    "functions": [
      "StorageExplorer.AdlsGen2.ExplorerCommand.createNewDirectory",
      "Azure.Storage.AdlsGen2.renamePath",
      "Azure.Storage.AdlsGen2.managePathPermissions",
      "Azure.Storage.AdlsGen2Actions.manageFileSystemPermissions",
      "Azure.Storage.AdlsGen2Actions.propagateFileSystemAclRecursively",
      "Azure.Storage.AdlsGen2.movePaths",
      "Azure.Storage.AdlsGen2.propagatePathAclRecursively",
      "Azure.Storage.AdlsGen2.generateSas",
      "Azure.Storage.AdlsGen2.openGenerateSasDialog",
      "Azure.Storage.AdlsGen2.graphClient.searchForGraphObj",
      "Azure.Storage.AdlsGen2.graphClient.getGraphObj"
    ],
    "resources": [
      {
        "namespace": "FileSystemActivities",
        "module": "./resources/FileSystemActivities"
      },
      {
        "namespace": "ManagePosixAcl",
        "module": "./resources/ManagePosixAcl"
      },
      {
        "namespace": "GraphClient",
        "module": "./resources/GraphClient"
      },
      {
        "namespace": "PathActions",
        "module": "./resources/PathActions"
      },
      {
        "namespace": "RecursiveAcl",
        "module": "./resources/RecursiveAcl"
      }
    ]
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.4.1",
    "@storage-explorer/testing": "^4.0.0",
    "@types/jquery": "^3.5.25",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/sprintf-js": "^1.1.2",
    "storage-explorer": "^1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@azure/core-http": "^3.0.4",
    "@azure/core-rest-pipeline": "^1.22.0",
    "@azure/storage-file-datalake": "^12.27.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/ui-components": "^4.1.4",
    "jquery": "^3.6.0",
    "knockout": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2",
    "tslib": "^2.6.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}