{
  "name": "@storage-explorer/account-panel",
  "version": "5.4.1",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --no-core-http",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "echo \"No tests to run.\" && exit 0"
  },
  "storageExplorer": {
    "functions": [],
    "resources": [
      {
        "namespace": "AccountPanel",
        "module": "./resources/AccountPanel"
      }
    ],
    "panels": {
      "AccountPanel.accountPanel": {
        "view": "./dist/panels/AccountPanel/index.html"
      }
    },
    "verticalToolbarButtons": {
      "AccountPanel.openAccountPanel": {
        "type": "panel",
        "panelId": "AccountPanel.accountPanel",
        "icon": "Contact",
        "displayName": "AccountPanel.LabelOpenAccount"
      }
    }
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.2.4",
    "storage-explorer": "^1.37.0-beta.2",
    "typescript": "^5.0.0",
    "@storage-explorer/ui-components": "^5.0.13",
    "knockout": "^3.5.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2"
  },
  "author": "",
  "license": "ISC",
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}