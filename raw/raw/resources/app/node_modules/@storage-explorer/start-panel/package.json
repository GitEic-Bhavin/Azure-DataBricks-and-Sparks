{
  "name": "@storage-explorer/start-panel",
  "version": "1.0.9",
  "description": "",
  "main": "dist/src/main/index.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "init": "npm install",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "echo \"No tests to run.\" && exit 0"
  },
  "storageExplorer": {
    "configurations": [
      {
        "id": "application.startup",
        "type": "category",
        "title": "StartPanel.LabelSettingStartup"
      },
      {
        "id": "application.startup.showStart",
        "type": "boolean",
        "title": "StartPanel.LabelSettingShowStart",
        "description": "StartPanel.DescriptionSettingShowStart",
        "defaultValue": true
      }
    ],
    "functions": [
      "StorageExplorer.StartPanel.open",
      "StorageExplorer.StartPanel.close"
    ],
    "resources": [
      {
        "namespace": "StartPanel",
        "module": "resources/StartPanel"
      }
    ],
    "panels": {
      "startPanel": {
        "view": "./dist/src/panels/StartPanel/index.html"
      }
    }
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.0.0",
    "@types/node": "^18.16.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "storage-explorer": "^1.33.0-beta.3",
    "typescript": "^5.0.0",
    "@storage-explorer/ui-components": "^4.1.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}