{
  "name": "@storage-explorer/blob-extension",
  "version": "1.14.16",
  "description": "A Storage Explorer extension adding support for Azure Blob Storage.",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "test": "node --test dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "appConfigurations": [
      {
        "id": "blobExtension.blobContainerExplorer.columnData",
        "type": "string",
        "defaultValue": "{ \"columns\": [] }"
      },
      {
        "id": "blobExtension.blobExplorer.columnData",
        "type": "string",
        "defaultValue": "{ \"columns\": [] }"
      },
      {
        "id": "blobExtension.hnsBlobExplorer.columnData",
        "type": "string",
        "defaultValue": "{ \"columns\": [] }"
      }
    ],
    "dialogs": {
      "Blob.Dialog.SetAccessTier": {
        "dimensions": {
          "width": 430,
          "height": 520
        },
        "view": "./dist/src/Dialogs/index.html#setAccessTier"
      },
      "Blob.Dialog.CloneAndRehydrate": {
        "dimensions": {
          "width": 480,
          "height": 650
        },
        "view": "./dist/src/Dialogs/index.html#cloneAndRehydrate"
      }
    },
    "panels": {
      "blobEditor": {
        "view": "./dist/src/Explorers/index.html#blobEditor",
        "cloneCallback": "StorageExplorer.BlobContainer.onPanelClone"
      },
      "blobContainerExplorer": {
        "view": "./dist/src/Explorers/index.html#blobContainerExplorer",
        "cloneCallback": "StorageExplorer.BlobContainerExplorer.onPanelClone"
      }
    },
    "functions": [
      "Azure.Storage.BlobContainer.openExplorer",
      "Azure.Storage.BlobContainer.openSecondary",
      "Azure.Storage.BlobContainer.openGen2ExplorerNew",
      "Azure.Connect.connectionAdded.blobs",
      "Azure.Connect.doesCustomConnectionExistForConnection.blobs",
      "Azure.Connect.revealNodeForCustomConnection.blobs",
      "Azure.Storage.Blob.acquireLease",
      "Azure.Storage.Blob.breakLease",
      "Azure.Storage.Blob.editTags",
      "Azure.Storage.Blob.getTags",
      "Azure.Storage.Blob.setTags",
      "Azure.Storage.Blob.manageProperties",
      "Azure.Storage.Blob.setAccessTier",
      "Azure.Storage.Blob.setBatchAccessTier",
      "Azure.Storage.Blob.cloneAndRehydrate",
      "Azure.Storage.Blob.createSnapshot",
      "Azure.Storage.Blob.promoteSnapshot",
      "Azure.Storage.Blob.clone",
      "Azure.Storage.Blob.doesBlobPathExist",
      "Azure.Storage.Blob.selectionStatistics",
      "Azure.Storage.BlobContainer.acquireLease",
      "Azure.Storage.BlobContainer.breakLease",
      "Azure.Storage.BlobContainer.manageStoredAccessPolicies",
      "Azure.Storage.BlobContainer.listBlobsSegment",
      "Azure.Storage.BlobContainer.listBlobsFlatSegment",
      "Azure.Storage.BlobContainer.manageMetadata",
      "Azure.Storage.BlobContainer.manageAccessLevel",
      "Azure.Storage.BlobContainer.manageAccessLevels",
      "Azure.Storage.BlobContainer.copyContainer",
      "Azure.Storage.BlobContainer.copyContainerCallback",
      "StorageExplorer.Blob.NodeAction.copyContainerToClipboard",
      "StorageExplorer.Blob.NodeAction.cloneContainer",
      "Azure.Storage.BlobContainer.createContainerAddNodeAndOpen",
      "Azure.Storage.BlobContainer.deleteContainerRemoveNodeAndClose",
      "Azure.Storage.BlobContainer.generateSas",
      "Azure.Storage.BlobService.configureCors",
      "Azure.Storage.BlobService.isAvailable",
      "Azure.Storage.BlobService.listContainers",
      "Azure.Storage.BlobService.generateSas",
      "Azure.Storage.BlobService.generateAccountSas",
      "Azure.Storage.BlobContainer.findBlobsByTags",
      "Azure.Storage.BlobService.getHnsInfo",
      "Azure.Storage.BlobService.openContainerByName",
      "Azure.Storage.BlobService.searchContainerByPrefix",
      "StorageExplorer.Blob.NodeAction.pasteContainer",
      "Azure.Storage.BlobExplorer.registerExtensionCommands",
      "Azure.Storage.BlobExplorer.registerOnItemDroppedEvent",
      "Azure.Storage.BlobExplorer.getOnItemDropEventConfig",
      "Azure.Storage.BlobExplorer.getExtensionCommands",
      "Azure.Storage.BlobContainer.registerExtensionActions",
      "Azure.Storage.BlobContainer.getExtensionActions",
      "StorageExplorer.BlobProducer.produceBlobServiceNode",
      "StorageExplorer.BlobProducer.produceBlobContainerNodes",
      "StorageExplorer.BlobProducer.produceAttachedBlobServiceNode",
      "StorageExplorer.BlobProducer.produceAttachedBlobContainerNodes",
      "StorageExplorer.BlobProducer.produceAzureADAttachedBlobContainerNodes",
      "StorageExplorer.BlobProducer.detachAttachedBlobContainerNode",
      "StorageExplorer.BlobProducer.produceQuickAccessNode",
      "StorageExplorer.BlobProducer.getContainerAttributes",
      "StorageExplorer.Blob.NodeAttribute.getCanPasteContainerAttribute",
      "Azure.Producers.Storage.CreateBlobContainerFromConnection",
      "Azure.Producers.Storage.GetAllBlobContainers",
      "Azure.Producers.Storage.GetSingleBlobContainerByName",
      "Azure.Storage.BlobExplorer.registerPasteHandlers",
      "Azure.Storage.BlobExplorer.getPasteHandlers",
      "Azure.Storage.Blob.promoteVersionTags",
      "Azure.Storage.BlobService.getDeleteRetentionPolicy",
      "Azure.Storage.BlobAttributes.getDeleteRetentionPolicy",
      "Azure.Storage.BlobActions.configureDeleteRetentionPolicy",
      "Azure.Storage.BlobAttributes.getAccountInfo",
      "Azure.Storage.BlobAttributes.getStatusDisplay",
      "Azure.Storage.BlobAttributes.getImmutabilityPolicy",
      "Azure.Storage.BlobAttributes.getLegalHold",
      "StorageExplorer.Blob.getContainerAccessPolicies",
      "StorageExplorer.Blob.NodeAction.copyDeepLinkV2",
      "StorageExplorer.Blob.handleAuthError",
      "StorageExplorer.BlobContainer.doesContainerExist",
      "StorageExplorer.BlobService.validateBlobContainerName",
      "StorageExplorer.Blob.getProperties",
      "StorageExplorer.Blob.downloadToBuffer",
      "StorageExplorer.Blob.downloadToBase64",
      "StorageExplorer.BlobContainer.onPanelClone",
      "StorageExplorer.Blob.NodeAction.renameAttachedBlobContainer",
      "StorageExplorer.Blob.delete",
      "StorageExplorer.Blob.hnsDelete",
      "StorageExplorer.BlobService.NodeAction.viewAll",
      "StorageExplorer.BlobContainerExplorer.onPanelClone",
      "Azure.Storage.BlobService.detachAll"
    ],
    "resources": [
      {
        "namespace": "BlobNodeProducer",
        "module": "resources/BlobNodeProducer"
      },
      {
        "namespace": "BlobEditor",
        "module": "resources/BlobEditor"
      },
      {
        "namespace": "BlobServiceActions",
        "module": "resources/BlobServiceActions"
      },
      {
        "namespace": "BlobActions",
        "module": "resources/BlobActions"
      },
      {
        "namespace": "BlobContainerActions",
        "module": "resources/BlobContainerActions"
      },
      {
        "namespace": "SetAccessTierDialog",
        "module": "resources/SetAccessTierDialog"
      },
      {
        "namespace": "CloneAndRehydrateDialog",
        "module": "resources/CloneAndRehydrateDialog"
      },
      {
        "namespace": "BlobExtensionSettings",
        "module": "resources/BlobExtensionSettings"
      },
      {
        "namespace": "BlobContainerExplorer",
        "module": "./resources/BlobContainerExplorer"
      }
    ],
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Microsoft.Storage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts/external"
        ],
        "nodeType": "Azure.BlobContainerGroup",
        "function": "StorageExplorer.BlobProducer.produceBlobServiceNode",
        "args": [
          "id",
          "subscription",
          "blobEndpoint",
          "secondaryBlobEndpoint",
          "primaryConnectionString",
          "secondaryConnectionString",
          "primaryKey",
          "accountKeys",
          "isHnsEnabled",
          "allowSharedKeyAccess",
          "accountKind",
          "skuTier",
          "accessTier",
          "customDomain",
          "supportsBlobs",
          "resourceGroup",
          "servicesAreAvailable"
        ]
      },
      {
        "parentNodeTypes": [
          "Azure.BlobContainerGroup"
        ],
        "nodeType": "Azure.BlobContainer",
        "search": {
          "searchType": "Azure.BlobContainerSearchType",
          "searchLabel": "BlobNodeProducer.BlobContainerNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        },
        "function": "StorageExplorer.BlobProducer.produceBlobContainerNodes",
        "args": [
          "id",
          "subscription",
          "connection",
          "secondaryConnection",
          "connectionString",
          "secondaryConnectionString",
          "skuTier",
          "accessTier",
          "accountKind",
          "isHnsEnabled",
          "customDomain",
          "customDomainConnection",
          "accountName",
          "resourceGroup"
        ]
      },
      {
        "parentNodeTypes": [
          "Microsoft.ClassicStorage/storageAccounts/sas"
        ],
        "nodeType": "StorageExplorer.AttachedBlobService",
        "function": "StorageExplorer.BlobProducer.produceAttachedBlobServiceNode",
        "args": []
      },
      {
        "parentNodeTypes": [
          "StorageExplorer.AttachedBlobService"
        ],
        "nodeType": "Azure.BlobContainer",
        "search": {
          "searchType": "Azure.BlobContainerSearchType",
          "searchLabel": "BlobNodeProducer.BlobContainerNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        },
        "function": "StorageExplorer.BlobProducer.produceAttachedBlobContainerNodes",
        "args": []
      }
    ],
    "jobHandlers": [
      {
        "queueName": "blob-changeAccessTier",
        "jobHandlerClass": "dist/src/JobHandlers/BlobJobsHandler.js",
        "resourceType": "quick"
      },
      {
        "queueName": "undelete",
        "jobHandlerClass": "dist/src/JobHandlers/BlobJobsHandler.js",
        "resourceType": "quick"
      }
    ],
    "extensibility": [
      {
        "extensibilityPoint": "blobExplorerCommands",
        "function": "Azure.Storage.BlobExplorer.registerExtensionCommands"
      },
      {
        "extensibilityPoint": "blobExplorerDragAndDropHandlers",
        "function": "Azure.Storage.BlobExplorer.registerOnItemDroppedEvent"
      },
      {
        "extensibilityPoint": "blobContainerActions",
        "function": "Azure.Storage.BlobContainer.registerExtensionActions"
      },
      {
        "extensibilityPoint": "blobExplorerPasteHandlers",
        "function": "Azure.Storage.BlobExplorer.registerPasteHandlers"
      }
    ],
    "configurations": [
      {
        "id": "dataExplorers.blobExplorer",
        "type": "category",
        "title": "BlobExtensionSettings.TitleBlobEditor",
        "sortOrder": 2
      },
      {
        "id": "dataExplorers.blobExplorer.defaultListMode",
        "type": "enum",
        "title": "BlobExtensionSettings.TitleDefaultListMode",
        "description": "BlobExtensionSettings.DescriptionDefaultListMode",
        "defaultValue": "Hierarchical",
        "enumValues": {
          "Hierarchical": {
            "displayName": "BlobExtensionSettings.EnumHierarchicalListMode",
            "sortOrder": 1
          },
          "Flat": {
            "displayName": "BlobExtensionSettings.EnumFlatListMode",
            "sortOrder": 2
          }
        }
      },
      {
        "id": "dataExplorers.blobExplorer.openViewOptionsByDefault",
        "type": "boolean",
        "title": "BlobExtensionSettings.TitleOpenViewOptionsByDefault",
        "description": "BlobExtensionSettings.DescriptionOpenViewOptionsByDefault",
        "defaultValue": false
      },
      {
        "id": "dataExplorers.blobExplorer.showStubBlobs",
        "type": "boolean",
        "title": "BlobExtensionSettings.TitleShowStubBlobs",
        "description": "BlobExtensionSettings.DescriptionShowStubBlobs",
        "defaultValue": false
      }
    ]
  },
  "devDependencies": {
    "@azure-tools/azcopy-node": "3.4.13-rc.1",
    "@azure/identity": "^4.1.0",
    "@storage-explorer/build-common": "^1.4.1",
    "@storage-explorer/testing": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/sprintf-js": "^1.1.2",
    "typescript": "^5.0.0",
    "@azure/arm-storage": "17.2.1",
    "@azure/core-http": "^3.0.0",
    "@azure/storage-blob": "12.28.0",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/job-queue": "^1.0.0",
    "@storage-explorer/ui-components": "^4.1.21",
    "knockout": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2",
    "storage-explorer": "^1.39.0-beta.2"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}