{
  "name": "@storage-explorer/table-extension",
  "version": "1.5.16",
  "description": "",
  "main": "dist/src/index.js",
  "typings": "dist/src/index.d.ts",
  "scripts": {
    "init": "npm install",
    "reset": "git clean -fdx",
    "build": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . --preserve-src-dir --no-core-http",
    "package": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . package",
    "start": "gulp -f ./node_modules/@storage-explorer/build-common/gulp/gulpfile.esbuild-extension.js --cwd . start",
    "test": "node --test dist/test/**/*.js"
  },
  "license": "UNLICENSED",
  "storageExplorer": {
    "appConfigurations": [
      {
        "id": "tableExtension.tableExplorer.columnData",
        "type": "string",
        "defaultValue": "{}"
      }
    ],
    "configurations": [
      {
        "id": "dataExplorers.tableExplorer",
        "type": "category",
        "title": "TableEditor.TitleTableExplorer",
        "sortOrder": 5
      },
      {
        "id": "dataExplorers.tableExplorer.dateTimeFormat",
        "type": "enum",
        "title": "TableEditor.TitleDateTimeFormat",
        "description": "TableEditor.DescriptionDateTimeFormat",
        "enumValues": {
          "none": {
            "displayName": "TableEditor.OptionDateTimeFormatNone",
            "description": "TableEditor.DescriptionDateTimeFormatNone",
            "sortOrder": 1
          },
          "local": {
            "displayName": "TableEditor.OptionDateTimeFormatLocal",
            "description": "TableEditor.DescriptionDateTimeFormatLocal",
            "sortOrder": 2
          },
          "utc": {
            "displayName": "TableEditor.OptionDateTimeFormatUtc",
            "description": "TableEditor.DescriptionDateTimeFormatUtc",
            "sortOrder": 3
          }
        },
        "defaultValue": "none"
      }
    ],
    "dialogs": {
      "addEntity": {
        "view": "./dist/src/Dialogs/index.html#addEntity",
        "dimensions": {
          "width": 700,
          "height": 510
        }
      },
      "duplicateEntity": {
        "view": "./dist/src/Dialogs/index.html#duplicateEntity",
        "dimensions": {
          "width": 700,
          "height": 510
        }
      },
      "editEntity": {
        "view": "./dist/src/Dialogs/index.html#editEntity",
        "dimensions": {
          "width": 700,
          "height": 510
        }
      },
      "exportEntities": {
        "view": "./dist/src/Dialogs/index.html#exportEntities",
        "dimensions": {
          "width": 650,
          "height": 500
        }
      },
      "importEntities": {
        "view": "./dist/src/Dialogs/index.html#importEntities",
        "dimensions": {
          "width": 800,
          "height": 600
        }
      },
      "querySelect": {
        "view": "./dist/src/Dialogs/index.html#querySelect",
        "dimensions": {
          "width": 500,
          "height": 600
        }
      }
    },
    "panels": {
      "tableExplorer": {
        "view": "./dist/src/Panels/TableExplorerReact/index.html",
        "cloneCallback": "StorageExplorer.Table.Panel.onPanelClone"
      }
    },
    "functions": [
      "Azure.Connect.connectionAdded.tables",
      "Azure.Storage.Table.createEntity",
      "Azure.Storage.Table.deleteEntities",
      "Azure.Storage.Table.generateSas",
      "Azure.Storage.Table.getAccessPolicies",
      "Azure.Storage.Table.listEntitiesSegment",
      "Azure.Storage.Table.mergeEntity",
      "Azure.Storage.Table.replaceEntity",
      "Azure.Storage.TableService.listTablesSegment",
      "Azure.Storage.TableService.searchTableByPrefix",
      "StorageExplorer.Table.AttributeLoader.getCanPasteTableAttributes",
      "StorageExplorer.Table.Command.exportEntities",
      "StorageExplorer.Table.Command.getStats",
      "StorageExplorer.Table.Command.importEntities",
      "StorageExplorer.Table.Command.openQuery",
      "StorageExplorer.Table.Command.saveQuery",
      "StorageExplorer.Table.NodeAction.cloneTable",
      "StorageExplorer.Table.NodeAction.copyLinkToResource",
      "StorageExplorer.Table.NodeAction.copyTableToClipboard",
      "StorageExplorer.Table.NodeAction.createTable",
      "StorageExplorer.Table.NodeAction.deleteTable",
      "StorageExplorer.Table.NodeAction.detachTable",
      "StorageExplorer.Table.NodeAction.generateSas",
      "StorageExplorer.Table.NodeAction.manageAcl",
      "StorageExplorer.Table.NodeAction.manageCors",
      "StorageExplorer.Table.NodeAction.openExplorer",
      "StorageExplorer.Table.NodeAction.openTableByName",
      "StorageExplorer.Table.NodeAction.pasteTable",
      "StorageExplorer.Table.NodeAction.renameAttachedTable",
      "StorageExplorer.Table.NodeAction.detachAll",
      "StorageExplorer.Table.Panel.onPanelClone",
      "StorageExplorer.Table.Producer.produceAttachedTableNodes",
      "StorageExplorer.Table.Producer.produceAttachedTableServiceNode",
      "StorageExplorer.Table.Producer.produceQuickAccessTableNode",
      "StorageExplorer.Table.Producer.produceTableNodes",
      "StorageExplorer.Table.Producer.produceTableServiceNode",
      "StorageExplorer.Table.Utilities.getSampleEntity",
      "StorageExplorer.Table.Validation.validateTableName",
      "Azure.Producers.Storage.GetSingleTableByName",
      "Azure.Producers.Storage.GetSASTables"
    ],
    "jobHandlers": [
      {
        "queueName": "table-copy",
        "jobHandlerClass": "dist/src/Jobs/TableJobsHandler.js",
        "resourceType": "networkRequestHeavy"
      },
      {
        "queueName": "table-export",
        "jobHandlerClass": "dist/src/Jobs/TableJobsHandler.js",
        "resourceType": "networkRequestHeavy"
      },
      {
        "queueName": "table-import",
        "jobHandlerClass": "dist/src/Jobs/TableJobsHandler.js",
        "resourceType": "networkRequestHeavy"
      },
      {
        "queueName": "table-stats",
        "jobHandlerClass": "dist/src/Jobs/TableJobsHandler.js",
        "resourceType": "networkRequestHeavy"
      }
    ],
    "nodeProducers": [
      {
        "parentNodeTypes": [
          "Microsoft.Storage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts",
          "Microsoft.ClassicStorage/storageAccounts/external"
        ],
        "nodeType": "Azure.TableGroup",
        "function": "StorageExplorer.Table.Producer.produceTableServiceNode",
        "args": [
          "subscription",
          "accountName",
          "id",
          "accountKeys",
          "tableEndpoint",
          "secondaryTableEndpoint",
          "primaryConnectionString",
          "secondaryConnectionString",
          "supportsTables",
          "allowSharedKeyAccess",
          "servicesAreAvailable"
        ]
      },
      {
        "parentNodeTypes": [
          "Azure.TableGroup"
        ],
        "nodeType": "Azure.Table",
        "function": "StorageExplorer.Table.Producer.produceTableNodes",
        "args": [
          "connection",
          "tableEndpoint",
          "connectionString",
          "secondaryConnection",
          "secondaryTableEndpoint",
          "secondaryConnectionString",
          "accountName",
          "storageAccountId",
          "subscription",
          "accountKind",
          "skuTier",
          "resourceGroup"
        ],
        "search": {
          "searchType": "Azure.TableSearchType",
          "searchLabel": "TableNodes.TableNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        }
      },
      {
        "parentNodeTypes": [
          "Microsoft.ClassicStorage/storageAccounts/sas"
        ],
        "nodeType": "StorageExplorer.AttachedTableService",
        "function": "StorageExplorer.Table.Producer.produceAttachedTableServiceNode",
        "args": []
      },
      {
        "parentNodeTypes": [
          "StorageExplorer.AttachedTableService"
        ],
        "nodeType": "Azure.Table",
        "function": "StorageExplorer.Table.Producer.produceAttachedTableNodes",
        "args": [],
        "search": {
          "searchType": "Azure.TableSearchType",
          "searchLabel": "TableNodes.TableNodeSearchLabel",
          "enableConfigId": "services.storageAccounts.enable"
        }
      }
    ],
    "resources": [
      {
        "namespace": "EntityEditorDialog",
        "module": "./resources/EntityEditorDialog"
      },
      {
        "namespace": "ImportExportEntitiesDialog",
        "module": "./resources/ImportExportEntitiesDialog"
      },
      {
        "namespace": "QuerySelectDialog",
        "module": "./resources/QuerySelectDialog"
      },
      {
        "namespace": "TableActions",
        "module": "resources/TableActions"
      },
      {
        "namespace": "TableEditor",
        "module": "resources/TableEditor"
      },
      {
        "namespace": "TableNodes",
        "module": "resources/TableNodes"
      }
    ]
  },
  "devDependencies": {
    "@storage-explorer/build-common": "^1.4.1",
    "@storage-explorer/testing": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sprintf-js": "^1.1.2",
    "@types/stream-json": "^1.7.8",
    "tslib": "^2.0.0",
    "typescript": "^5.0.0",
    "@azure/core-client": "^1.10.0",
    "@azure/data-tables": "^13.3.1",
    "@js-temporal/polyfill": "^0.4.4",
    "@storage-explorer/azure-connections": "^5.0.11",
    "@storage-explorer/azure-sdk-helpers": "^5.2.4",
    "@storage-explorer/job-queue": "^1.0.0",
    "@storage-explorer/ui-components": "^5.0.15",
    "csv-parse": "^5.3.6",
    "csv-stringify": "^6.3.0",
    "knockout": "^3.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "se-exception-serializer": "^0.1.4",
    "sprintf-js": "^1.1.2",
    "storage-explorer": "^1.37.0-beta.2",
    "stream-json": "^1.9.1"
  },
  "overrides": {
    "es5-ext": "0.10.53"
  },
  "browser": {
    "os": "os-browserify/browser",
    "path": "path-browserify"
  }
}